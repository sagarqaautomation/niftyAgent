# =========================
# APPLICATION
# =========================
APP_NAME=nifty-intraday-agent
DB_PATH=data/nifty_agent.db
LOG_LEVEL=INFO

# =========================
# MARKET
# =========================
UNDERLYING=NIFTY
MARKET_TIMEZONE=Asia/Kolkata
CANDLE_TIMEFRAME=1min
CONFIDENCE_THRESHOLD=7
MIN_TOTAL_SCORE=7

# Risk model
ATR_SL_MULTIPLIER=1.2
REWARD_RISK=1.6
SIGNAL_EXPIRY_MINUTES=30

# =========================
# ZERODHA / KITE
# =========================
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# NIFTY index instrument token must be confirmed from the current broker instrument dump.
NIFTY_INSTRUMENT_TOKEN=

# Optional CSV path generated from broker instrument dump
KITE_INSTRUMENTS_CSV=data/instruments.csv

# =========================
# NEWS
# =========================
NEWS_ENABLED=true
NEWS_REFRESH_SECONDS=120

# =========================
# WHATSAPP / TWILIO
# =========================
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# =========================
# LIVE MODE
# =========================
LIVE_MARKET_DATA=false
PAPER_TRADING=true
AUTO_ORDER_PLACEMENT=false
