# =========================
# APPLICATION
# =========================
APP_NAME=nifty-intraday-agent
DB_PATH=data/nifty_agent.db
LOG_LEVEL=INFO

# =========================
# MARKET
# =========================
UNDERLYING=NIFTY
MARKET_TIMEZONE=Asia/Kolkata
CANDLE_TIMEFRAME=1min
CONFIDENCE_THRESHOLD=7
MIN_TOTAL_SCORE=7
MINIMUM_HISTORY_BARS=60
MIN_TREND_ADX=20
STRONG_TREND_ADX=25
RANGE_MARKET_MIN_SCORE=8
HIGH_VOLATILITY_MIN_SCORE=8
HIGH_VOLATILITY_ATR_PCT=0.30
RELATIVE_VOLUME_THRESHOLD=1.25
MINIMUM_CANDLE_STRENGTH=0.65
MINIMUM_REWARD_RISK=1.5
SIGNAL_COOLDOWN_MINUTES=5
SETUP_RESET_BARS=3
NEWS_MAX_AGE_MINUTES=60

# Experimental precision filter. Keep OFF until walk-forward validation proves
# that it improves out-of-sample expectancy and hit rate.
PRECISION_MODE=false
PRECISION_MIN_SCORE=8
PRECISION_MIN_ADX=25
PRECISION_REQUIRE_STRUCTURE=true
PRECISION_REQUIRE_CANDLE=true
PRECISION_REQUIRE_RSI=true
PROBABILITY_GATE_ENABLED=false
PROBABILITY_MIN_WIN_RATE=0.60
PROBABILITY_MIN_SAMPLES=40
SETUP_PROFILES_PATH=data/setup_profiles.json

# Risk model
ATR_SL_MULTIPLIER=1.2
REWARD_RISK=1.6
SIGNAL_EXPIRY_MINUTES=30

# =========================
# ZERODHA / KITE
# =========================
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Legacy NIFTY index token; the signal worker uses a volume-bearing NIFTY future.
NIFTY_INSTRUMENT_TOKEN=

# Optional: pin a NIFTY futures token instead of auto-selecting the nearest expiry.
NIFTY_FUTURE_INSTRUMENT_TOKEN=

# Optional CSV path generated from broker instrument dump
KITE_INSTRUMENTS_CSV=data/instruments.csv

# Scan the editable NSE equity universe in this CSV when live data is enabled.
EQUITY_SCAN_ENABLED=true
EQUITY_WATCHLIST_PATH=data/equity_watchlist.csv
# Optional current NIFTY 50 weights CSV (columns: symbol,weight_pct); omit to use equal-weight breadth.
NIFTY50_WEIGHTS_PATH=data/nifty50_weights.csv

# =========================
# NEWS
# =========================
NEWS_ENABLED=true
NEWS_REFRESH_SECONDS=120

# =========================
# WHATSAPP / TWILIO
# =========================
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
# Optional JSON mapping of approved template placeholders to signal fields.
# Example: {"1":"signal","2":"signal_instrument","3":"signal_candle_time","4":"spot_reference_price","5":"entry_price","6":"target_price","7":"stop_loss"}
TWILIO_CONTENT_VARIABLES=
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# =========================
# LIVE MODE
# =========================
LIVE_MARKET_DATA=false
PAPER_TRADING=true
AUTO_ORDER_PLACEMENT=false

# v2.1 experimental transition loss-cluster gate (keep false until walk-forward proves improvement)
TRANSITION_REQUIRE_DI_ALIGNMENT=false
